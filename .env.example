# Copy to .env.local (never commit .env.local). See README and docs/deployment.md.

# Written by `pnpm dlx convex dev`: the dev Convex deployment and its URLs.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Shared with the Convex deployment (`npx convex env set REVALIDATE_SECRET …`):
# lets Convex tell the site to refresh a page after something is published.
REVALIDATE_SECRET=

# Absolute URL of the public site (sitemap, share links, structured data).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
